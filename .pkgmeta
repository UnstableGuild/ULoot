package-as: ULoot

externals:
  Libs/: https://github.com/WoWUIDev/Ace3.git
  Modules/Options/Libs/: https://github.com/WoWUIDev/Ace3.git

ignore:
  - .pkgmeta
  - .github
  - .gitignore
  - .pre-commit-config.yaml
  - README.md
  - CLAUDE.md
  - .claude

move-folders:
  ULoot/Modules/Frame: ULoot_Frame
  ULoot/Modules/Group: ULoot_Group
  ULoot/Modules/Options: ULoot_Options
